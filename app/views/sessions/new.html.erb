<%# NOTE: the sign in form - the left half of the split screen.
    IMPORTANT: the form is the same form as before, it only has a modern
    design: a caption, a heading, fields with an icon and a full width button. %>
<p class="auth-eyebrow">Start your journey</p>
<h1 class="auth-title">Sign in to User Management</h1>
<p class="auth-lead">
  Use the e-mail address you registered with. Any non-empty password is accepted.
</p>

<%= form_with url: login_path, method: :post, local: true, id: "login-form" do %>
  <%# NOTE: the e-mail. The icon is a decoration, the label is the real label
      of the field (the "for" attribute points to the id of the input). %>
  <div class="auth-field">
    <%= label_tag :email, "E-mail", class: "form-label", for: getUniqIdValue("login-email") %>
    <div class="auth-field-control">
      <i class="bi bi-envelope auth-field-icon" aria-hidden="true"></i>
      <input type="email" name="email" id="<%= getUniqIdValue("login-email") %>"
             value="<%= @email %>" required autofocus autocomplete="username"
             class="form-control <%= 'is-invalid' if flash[:alert].present? %>"
             data-bs-toggle="tooltip"
             title="The e-mail address you registered with.">
    </div>
  </div>

  <%# NOTE: the password with the button that shows the password. %>
  <div class="auth-field">
    <%= label_tag :password, "Password", class: "form-label", for: getUniqIdValue("login-password") %>
    <div class="auth-field-control">
      <i class="bi bi-key auth-field-icon" aria-hidden="true"></i>
      <input type="password" name="password" id="<%= getUniqIdValue("login-password") %>"
             required autocomplete="current-password"
             class="form-control <%= 'is-invalid' if flash[:alert].present? %>"
             data-bs-toggle="tooltip"
             title="Any non-empty password is accepted - one character is enough.">
      <button type="button" class="auth-field-action" data-toggle-password="<%= getUniqIdValue("login-password") %>"
              aria-label="Show the password" data-bs-toggle="tooltip" title="Show the password">
        <i class="bi bi-eye" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <div class="auth-options">
    <div class="form-check">
      <%# NOTE: "remember me" - the session of a remembered account survives
          the restart of the browser (30 days). %>
      <input class="form-check-input" type="checkbox" name="remember_me" value="1" id="<%= getUniqIdValue("login-remember") %>">
      <label class="form-check-label" for="<%= getUniqIdValue("login-remember") %>">Remember me</label>
    </div>
    <span class="text-body-secondary">
      <i class="bi bi-info-circle me-1" aria-hidden="true"></i>Blocked? Ask an administrator.
    </span>
  </div>

  <%= submit_tag "Sign in", class: "btn btn-primary auth-submit" %>
<% end %>

<div class="auth-foot">
  <span>Don't have an account? <%= link_to "Sign up", signup_path %></span>
  <span><%= link_to "User table", users_path, class: "text-decoration-none" %> &middot; <%= link_to "Assistant", assistant_path, class: "text-decoration-none" %></span>
</div>

<div class="auth-note">
  <i class="bi bi-shield-lock" aria-hidden="true"></i>
  <span>
    The session is checked on <strong>every</strong> request: as soon as an account is
    blocked or deleted, the next request goes back to this page.
  </span>
</div>
