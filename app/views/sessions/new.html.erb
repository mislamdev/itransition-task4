<%# NOTE: the sign in form. A visitor that is not signed in only sees this
    form and the registration form - nothing else. %>
<div class="row justify-content-center">
  <div class="col-12 col-sm-9 col-md-7 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-header bg-body-tertiary">
        <h1 class="h5 mb-0"><i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Sign in</h1>
      </div>

      <div class="card-body">
        <%= form_with url: login_path, method: :post, local: true, id: "login-form" do %>
          <div class="mb-3">
            <%= label_tag :email, "E-mail", class: "form-label", for: getUniqIdValue("login-email") %>
            <%# IMPORTANT: the id of the input and the "for" of the label are
                produced by getUniqIdValue, so they always match. %>
            <input type="email" name="email" id="<%= getUniqIdValue("login-email") %>"
                   value="<%= @email %>" required autofocus autocomplete="username"
                   class="form-control <%= 'is-invalid' if flash[:alert].present? %>"
                   data-bs-toggle="tooltip"
                   title="The e-mail address you registered with.">
          </div>

          <div class="mb-3">
            <%= label_tag :password, "Password", class: "form-label", for: getUniqIdValue("login-password") %>
            <input type="password" name="password" id="<%= getUniqIdValue("login-password") %>"
                   required autocomplete="current-password"
                   class="form-control <%= 'is-invalid' if flash[:alert].present? %>"
                   data-bs-toggle="tooltip"
                   title="Any non-empty password is accepted - one character is enough.">
          </div>

          <div class="d-flex justify-content-between align-items-center">
            <%= submit_tag "Sign in", class: "btn btn-primary" %>
            <span class="small text-body-secondary">
              No account yet? <%= link_to "Register", signup_path, class: "link-primary" %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
