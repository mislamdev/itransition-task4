<div class="app-main">

  <%# ----------------------------------------------------------------------- %>
  <%# THE HEADER OF THE PAGE - the title and the counters of the table. %>
  <%# ----------------------------------------------------------------------- %>
  <div class="page-header">
    <div>
      <h1 class="page-title">User management</h1>
      <p class="page-subtitle">
        Every account of the application - sorted by the last login time.
      </p>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3">
      <div class="stat-strip">
        <span class="stat-pill"><strong><%= @total_count %></strong> in the view</span>
        <span class="stat-pill"><strong><%= @active_count %></strong> active</span>
        <span class="stat-pill"><strong><%= @blocked_count %></strong> blocked</span>
      </div>
      <%= link_to "Ask the assistant", assistant_path, class: "btn btn-light btn-sm" %>
    </div>
  </div>

  <%# ----------------------------------------------------------------------- %>
  <%# THE ASSISTANT - it answers questions about the data and it controls the %>
  <%# table (selection, filtering, sorting, blocking, deleting). %>
  <%# ----------------------------------------------------------------------- %>
  <div class="card assistant-card mb-3" id="assistant-card">
    <div class="card-header d-flex align-items-center gap-2">
      <i class="bi bi-stars" aria-hidden="true"></i>
      <h2 class="h6 mb-0">Assistant</h2>
      <span class="small fw-normal text-body-secondary">
        Ask a question or give a command, e.g. &ldquo;select users with e-mails started with s or p&rdquo;.
      </span>
    </div>
    <div class="card-body">
      <form id="assistant-form" class="row g-2" autocomplete="off">
        <div class="col-12 col-md">
          <label class="visually-hidden" for="<%= getUniqIdValue("assistant-input") %>">Question or command</label>
          <input type="text" class="form-control assistant-input" id="<%= getUniqIdValue("assistant-input") %>"
                 name="command" placeholder="How many users are blocked?"
                 data-assistant-input
                 data-bs-toggle="tooltip"
                 title="The assistant asks the REST API for the numbers - it never counts by itself.">
        </div>
        <div class="col-12 col-md-auto d-flex gap-2">
          <button type="submit" class="btn btn-primary px-4" id="assistant-run">
            <i class="bi bi-send me-1" aria-hidden="true"></i>Run
          </button>
          <button type="button" class="btn btn-light" id="assistant-clear"
                  data-bs-toggle="tooltip" title="Clear the answer">
            <i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">Clear</span>
          </button>
        </div>
      </form>

      <div id="assistant-output" class="mt-3 d-none">
        <div class="alert assistant-answer d-flex align-items-start gap-2" role="status" id="assistant-answer">
          <i class="bi bi-chat-left-text-fill mt-1" aria-hidden="true"></i>
          <span class="assistant-answer-text"></span>
        </div>
        <details class="small text-body-secondary mt-2">
          <summary>Show the API calls and the plan</summary>
          <pre class="assistant-plan mt-2 mb-0"></pre>
        </details>
      </div>
    </div>
  </div>

  <%# ----------------------------------------------------------------------- %>
  <%# THE TABLE WITH THE TOOLBAR. %>
  <%#                                                                   %>
  <%# IMPORTANT: the whole card (toolbar + table) is one POST form. The     %>
  <%# toolbar buttons submit this form to different endpoints with the     %>
  <%# `formaction` attribute - and there is NOT a single button inside a   %>
  <%# table row.                                                              %>
  <%# ----------------------------------------------------------------------- %>
  <div class="card table-card">
    <%# NOTE: the filter form lives OUTSIDE of the selection form - two   %>
    <%# forms must not be nested. Its fields are inside the toolbar and   %>
    <%# belong to it with the HTML attribute `form`.                         %>
    <%= form_with url: users_path, method: :get, local: true, id: "filter-form", class: "visually-hidden" do %>
      <button type="submit">Apply the filter</button>
    <% end %>

    <%= form_with url: block_users_path, method: :post, local: true, id: "selection-form" do %>
      <%# NOTE: the toolbar. It is always visible - only the state of the %>
      <%# buttons changes (disabled when nothing is selected). %>
      <div class="card-header">
        <div class="toolbar">
          <div class="btn-toolbar gap-2" role="toolbar" aria-label="Actions for the selected users">
            <%# NOTE: the "Block" button - a button WITH text. %>
            <button type="submit" class="btn btn-outline-primary btn-sm" id="block-selected"
                    formaction="<%= block_users_path %>" disabled
                    data-bs-toggle="tooltip" data-bs-placement="top"
                    title="Block the selected users">
              <i class="bi bi-lock me-1" aria-hidden="true"></i>Block
            </button>

            <%# NOTE: the "Unblock" button - an ICON only. %>
            <button type="submit" class="btn btn-outline-primary btn-sm" id="unblock-selected"
                    formaction="<%= unblock_users_path %>" disabled
                    data-bs-toggle="tooltip" data-bs-placement="top"
                    title="Unblock the selected users" aria-label="Unblock the selected users">
              <i class="bi bi-unlock" aria-hidden="true"></i>
            </button>

            <%# NOTE: the "Delete" button - an ICON only. %>
            <button type="submit" class="btn btn-outline-danger btn-sm" id="delete-selected"
                    formaction="<%= delete_users_path %>" disabled
                    data-bs-toggle="tooltip" data-bs-placement="top"
                    title="Delete the selected users" aria-label="Delete the selected users">
              <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
          </div>

          <span class="toolbar-count" id="selection-info" aria-live="polite">
            <strong id="selection-count">0</strong> of <%= pluralize(@users.size, "row") %> selected
          </span>

          <%# NOTE: the filter of the table - the fields belong to the %>
          <%# filter form above (the attribute `form`). %>
          <div class="toolbar-filter">
            <div class="toolbar-search">
              <i class="bi bi-search" aria-hidden="true"></i>
              <input type="search" form="filter-form" name="q" value="<%= @query %>"
                     placeholder="Filter" aria-label="Filter the users by name or e-mail"
                     data-bs-toggle="tooltip" title="The table is filtered by name and e-mail.">
            </div>

            <select form="filter-form" name="status" class="form-select toolbar-select"
                    aria-label="Filter by status" data-bs-toggle="tooltip" title="Show only the accounts with this status.">
              <option value="all" <%= "selected" if @status_filter == "all" %>>All</option>
              <option value="active" <%= "selected" if @status_filter == "active" %>>Active</option>
              <option value="blocked" <%= "selected" if @status_filter == "blocked" %>>Blocked</option>
            </select>

            <select form="filter-form" name="sort" class="form-select toolbar-select"
                    aria-label="Sort by" data-bs-toggle="tooltip" title="The column the table is sorted by.">
              <% [["last_login_at", "Last login"], ["last_activity_at", "Last activity"],
                  ["name", "Name"], ["email", "E-mail"], ["position", "Position"], ["status", "Status"],
                  ["created_at", "Registered"]].each do |value, label| %>
                <option value="<%= value %>" <%= "selected" if @sort_column == value %>><%= label %></option>
              <% end %>
            </select>

            <select form="filter-form" name="direction" class="form-select toolbar-select"
                    aria-label="Direction" data-bs-toggle="tooltip" title="The direction of the order.">
              <option value="desc" <%= "selected" if @sort_direction == "desc" %>>Descending</option>
              <option value="asc" <%= "selected" if @sort_direction == "asc" %>>Ascending</option>
            </select>

            <button type="submit" form="filter-form" class="btn btn-light btn-sm"
                    data-bs-toggle="tooltip" title="Apply the filter">
              <i class="bi bi-funnel" aria-hidden="true"></i><span class="visually-hidden">Apply the filter</span>
            </button>
          </div>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle" id="users-table">
            <caption class="visually-hidden">
              The registered users. The table is sorted by <%= @sort_column.humanize.downcase %>
              (<%= @sort_direction %>).
            </caption>
            <thead>
              <tr>
                <%# NOTE: the header checkbox selects / deselects ALL the rows.
                    It has NO label - only a tooltip. %>
                <th scope="col" class="checkbox-column">
                  <input type="checkbox" class="form-check-input" id="select-all"
                         data-bs-toggle="tooltip" data-bs-placement="top"
                         title="Select or deselect all users"
                         aria-label="Select or deselect all users">
                </th>
                <th scope="col"><%= sort_link(:name, "Name") %></th>
                <th scope="col"><%= sort_link(:email, "E-mail") %></th>
                <th scope="col" class="text-center"><%= sort_link(:status, "Status") %></th>
                <th scope="col"><%= sort_link(:last_login_at, "Last login") %></th>
                <th scope="col"><%= sort_link(:last_activity_at, "Last activity") %></th>
              </tr>
            </thead>
            <tbody>
              <% if @users.empty? %>
                <tr>
                  <td colspan="6">
                    <div class="empty-state">
                      <i class="bi bi-inbox d-block mb-2" aria-hidden="true"></i>
                      No user matches the current filter.
                    </div>
                  </td>
                </tr>
              <% end %>

              <% @users.each do |user| %>
                <%# NOTE: a blocked account is dimmed and its name is struck %>
                <%# through - exactly like in the reference of the task. %>
                <tr data-user-id="<%= user.id %>" data-blocked="<%= user.blocked? %>"
                    class="<%= 'is-blocked' if user.blocked? %>">
                  <%# IMPORTANT: the leftmost column only holds a checkbox -
                      there is no button, no link and no label in the rows. %>
                  <td class="checkbox-column">
                    <input type="checkbox" class="form-check-input row-checkbox"
                           name="user_ids[]" value="<%= user.id %>"
                           aria-label="Select <%= user.name %> (<%= user.email %>)"
                           data-bs-toggle="tooltip" data-bs-placement="top"
                           title="Select <%= user.email %>">
                  </td>

                  <%# NOTE: the name and the position below it. %>
                  <td>
                    <span class="cell-strong"><%= user.name %></span>
                    <span class="cell-sub"><%= user.position.presence || "—" %></span>
                  </td>

                  <td class="text-nowrap"><%= user.email %></td>

                  <td class="text-center"><%= status_label(user) %></td>

                  <%# NOTE: the relative time, the exact timestamp is in the %>
                  <%# tooltip of the cell. %>
                  <td class="text-nowrap" data-bs-toggle="tooltip"
                      title="<%= exact_time(user.last_login_at) %>">
                    <%= relative_time(user.last_login_at) %>
                  </td>
                  <td class="text-nowrap" data-bs-toggle="tooltip"
                      title="<%= exact_time(user.last_activity_at) %>">
                    <%= relative_time(user.last_activity_at) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card-footer small d-flex flex-wrap justify-content-between gap-2">
        <span>
          Sorted by <strong><%= @sort_column.humanize.downcase %></strong>
          (<%= @sort_direction == "asc" ? "ascending" : "descending" %>).
        </span>
        <span>Use the checkboxes to select the rows, then use the toolbar above the table.</span>
      </div>
    <% end %>
  </div>
</div>
