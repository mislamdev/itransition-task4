<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="User management panel: registration, authentication and user administration.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# NOTE: the order of the stylesheets is the order of the theme:
        1. the CSS framework,
        2. the tokens (the design system),
        3. the mapping of the tokens onto the framework,
        4. the components of the application,
        5. the rules of the pages. %>
    <%= stylesheet_link_tag "bootstrap.min.css" %>
    <%= stylesheet_link_tag "bootstrap-icons.min.css" %>
    <%= stylesheet_link_tag "theme/tokens.css" %>
    <%= stylesheet_link_tag "theme/bootstrap-theme.css" %>
    <%= stylesheet_link_tag "theme/components.css" %>
    <%= stylesheet_link_tag "application.css" %>

    <%= javascript_include_tag "bootstrap.bundle.min.js" %>
    <%= javascript_include_tag "app.js", defer: true %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%# NOTE: the standard navigation header of the application. %>
    <nav class="navbar navbar-expand-lg app-navbar sticky-top">
      <div class="container-fluid">
        <%= render "shared/brand" %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#<%= getUniqIdValue("main-navbar") %>"
                aria-controls="<%= getUniqIdValue("main-navbar") %>" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="<%= getUniqIdValue("main-navbar") %>">
          <% if signed_in? %>
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <%= link_to "Users", users_path, class: "nav-link #{'active' if controller_name == 'users'}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Assistant", assistant_path, class: "nav-link #{'active' if controller_name == 'assistant'}" %>
              </li>
            </ul>

            <ul class="navbar-nav align-items-lg-center gap-2">
              <%# NOTE: the profile of the signed in account - the sign out %>
              <%# button is inside the dropdown menu of the profile. %>
              <li class="nav-item dropdown">
                <button class="account-chip dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        aria-label="The account of the signed in user">
                  <span class="account-avatar" aria-hidden="true"><%= current_user.name.to_s.first.to_s.upcase %></span>
                  <span class="account-email"><%= current_user.email %></span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <span class="dropdown-item-text">
                      <strong><%= current_user.name %></strong><br>
                      <small class="text-body-secondary"><%= current_user.email %></small>
                    </span>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%# NOTE: the sign out is a form button - the CSRF token %>
                    <%# of the session is sent with it. %>
                    <%= button_to "Sign out", logout_path, method: :delete,
                                  class: "dropdown-item dropdown-item-danger",
                                  form: { class: "dropdown-form" } %>
                  </li>
                </ul>
              </li>
            </ul>
          <% else %>
            <ul class="navbar-nav ms-auto">
              <li class="nav-item"><%= link_to "Sign in", login_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Register", signup_path, class: "nav-link" %></li>
            </ul>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="app-footer py-3 mt-auto">
      <div class="container-fluid small d-flex flex-wrap justify-content-between gap-2">
        <span>User Management &mdash; Ruby on Rails application.</span>
        <span>E-mail uniqueness is enforced by a UNIQUE INDEX in PostgreSQL.</span>
      </div>
    </footer>
  </body>
</html>
