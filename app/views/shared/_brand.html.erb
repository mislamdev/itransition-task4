<%# NOTE: the brand of the application - the mark and the wordmark.
    IMPORTANT: the mark is an inline SVG (no image file), therefore it stays
    sharp on every screen and it inherits the colour of the theme. %>
<%= link_to root_path, class: "brand #{local_assigns[:klass]}", aria: { label: "User Management - start page" } do %>
  <span class="brand-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path d="M4 7h16M4 12h16M4 17h9" />
      <circle cx="17.5" cy="17" r="2.5" />
    </svg>
  </span>
  <span class="brand-text">
    <span class="brand-title">User Management</span>
    <span class="brand-subtitle">Admin Console</span>
  </span>
<% end %>
